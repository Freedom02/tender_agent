{
  "meta": {
    "id": "InternalBidAgentOntology",
    "name": "公司内部投标专员智能体本体治理版",
    "version": "1.0.0",
    "status": "business_confirmation",
    "manual": {
      "name": "本体数据治理手册",
      "version": "V1.0"
    },
    "scope": [
      "招标信息自动搜索、筛选、下载",
      "招标文件解析、比对与匹配",
      "标书撰写、审核与输出",
      "本地已有招标文件接入"
    ],
    "subject": "单一公司内部投标专员"
  },
  "governanceProfile": {
    "goals": [
      "信息完备：源数据、版本和证据可回溯",
      "语义去重：同一业务语义只有一个权威归属",
      "路径精简：高频问题有最短稳定查询路径",
      "属性适度：每个对象保持业务人员可理解的粒度",
      "自然推理：关系名称和属性名称接近日常业务语言"
    ],
    "qualityTargets": {
      "maxKeyAttributesPerClass": 20,
      "maxHighFrequencyQueryPathSteps": 3,
      "maxSemanticDuplicateRate": 0.05,
      "top50BusinessQuestionReasoningRate": 0.95,
      "subgraphConsistencyRate": 0.95
    },
    "principles": [
      {
        "id": "P01",
        "name": "认知工具而非真实映射",
        "rule": "本体服务投标业务理解和决策，不要求把所有源表字段原样映射为业务对象。"
      },
      {
        "id": "P02",
        "name": "语义归属唯一",
        "rule": "每个业务语义属性必须有一个权威归属对象；其他对象通过关系或引用访问。"
      },
      {
        "id": "P03",
        "name": "三层分离",
        "rule": "源数据与证据放在数据映射层，业务关系放在关系构建层，面向模型的自然语言语义放在 AI 语义层。"
      },
      {
        "id": "P04",
        "name": "关系优先于属性",
        "rule": "信息具有独立查询、独立生命周期或多方关联时，建模为对象与关系，不重复挂载为普通属性。"
      },
      {
        "id": "P05",
        "name": "高频路径最短",
        "rule": "项目要求、企业材料、比对结论和标书响应之间保留直接可解释的关系。"
      },
      {
        "id": "P06",
        "name": "自然语言对齐",
        "rule": "类名、属性名和关系名优先使用投标专员的业务用语，并保留稳定的技术标识。"
      },
      {
        "id": "P07",
        "name": "原始数据可回溯",
        "rule": "原文、页码、文件哈希、来源和版本可以保留在映射层，但不得在 AI 语义层重复暴露。"
      }
    ],
    "layers": [
      {
        "id": "L1",
        "name": "数据映射层",
        "purpose": "保留原始文件、来源、版本、哈希、解析状态、页码和片段证据。",
        "allowRedundancy": true,
        "objects": [
          "source",
          "publications[]",
          "documents[]",
          "fileVersions[]",
          "evidences[]",
          "AgentRun"
        ]
      },
      {
        "id": "L2",
        "name": "关系构建层",
        "purpose": "建立企业、材料、项目、工作台、要求比对、模板、投标文件和导出包之间的业务关系。",
        "allowRedundancy": "仅允许关系索引和反向索引，不允许复制权威业务属性。",
        "objects": [
          "CompanyProfile",
          "CompanyMaterial",
          "TenderSearchProfile",
          "TenderProject",
          "BidWorkspace",
          "RequirementComparison",
          "BidTemplate",
          "BidDocument",
          "ReviewRecord",
          "ExportPackage"
        ]
      },
      {
        "id": "L3",
        "name": "AI 语义层",
        "purpose": "向大模型暴露自然语言标签、受控枚举、业务问题路径和证据引用。",
        "allowRedundancy": false,
        "objects": [
          "semanticLabels",
          "competencyQuestions",
          "controlledVocabularies"
        ]
      }
    ]
  },
  "logicalLibraries": [
    {
      "id": "LIB01",
      "name": "招标企业库",
      "purpose": "维护本公司作为投标主体的结构化能力和可核验材料。",
      "authoritativeObjects": [
        "CompanyProfile",
        "CompanyMaterial"
      ],
      "entryRules": [
        "系统只能有一个 CompanyProfile",
        "所有材料必须关联该 CompanyProfile",
        "资质、业绩和人员事实必须能回指材料或标记为待核验"
      ]
    },
    {
      "id": "LIB02",
      "name": "招标文件库",
      "purpose": "保存公告、答疑、补遗、延期和招标文件版本，并提供解析证据。",
      "authoritativeObjects": [
        "TenderProject.documents[]",
        "TenderProject.publications[]",
        "TenderProject.evidences[]"
      ],
      "entryRules": [
        "自动下载和本地上传必须进入同一 documents[] 链路",
        "文件以内容哈希和版本号去重",
        "补遗不覆盖历史版本"
      ]
    },
    {
      "id": "LIB03",
      "name": "招标库",
      "purpose": "维护可参与项目、项目要求、评分、关键日期和内部投标作业。",
      "authoritativeObjects": [
        "TenderProject",
        "BidWorkspace",
        "RequirementComparison"
      ],
      "entryRules": [
        "项目是公告、文件、要求、评分、日期和证据的主聚合体",
        "一条要求一次比对形成一条可审查记录",
        "要求变更后受影响比对必须标记待复核"
      ]
    },
    {
      "id": "LIB04",
      "name": "标书库",
      "purpose": "管理投标文件章节、版本、审核、完整性和最终导出包。",
      "authoritativeObjects": [
        "BidDocument",
        "ReviewRecord",
        "ExportPackage"
      ],
      "entryRules": [
        "正式正文必须关联要求、材料或证据引用",
        "导出包固定引用文件版本",
        "否决性要求未通过审核时禁止导出"
      ]
    },
    {
      "id": "LIB05",
      "name": "标书模板库",
      "purpose": "维护可按服务类型、采购方式和规则选用的模板版本。",
      "authoritativeObjects": [
        "BidTemplate"
      ],
      "entryRules": [
        "模板编码和版本号唯一",
        "模板章节标记是否必填和适用条件",
        "审核通过前只能用于预览，不能作为正式导出依据"
      ]
    }
  ],
