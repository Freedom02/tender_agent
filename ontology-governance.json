      "from": "BidTemplate",
      "verb": "约束结构",
      "to": "BidDocument",
      "cardinality": "1:N",
      "path": "BidTemplate -> BidDocument",
      "purpose": "记录模板与投标文件章节映射。"
    },
    {
      "id": "R12",
      "from": "BidDocument",
      "verb": "回应",
      "to": "TenderProject.requirements[]",
      "cardinality": "N:1",
      "path": "BidDocument.sections[] -> TenderProject.requirements[]",
      "purpose": "避免标书章节遗漏或错回应要求。"
    },
    {
      "id": "R13",
      "from": "ReviewRecord",
      "verb": "审核",
      "to": "RequirementComparison|BidWorkspace|BidTemplate|BidDocument|ExportPackage",
      "cardinality": "N:1",
      "path": "ReviewRecord -> reviewTargetRef",
      "purpose": "保留人工审核和整改闭环。"
    },
    {
      "id": "R14",
      "from": "BidWorkspace",
      "verb": "导出",
      "to": "ExportPackage",
      "cardinality": "1:N",
      "path": "BidWorkspace -> ExportPackage",
      "purpose": "形成固定批次的递交文件集合。"
    },
    {
      "id": "R15",
      "from": "ExportPackage",
      "verb": "包含",
      "to": "BidDocument",
      "cardinality": "N:N",
      "path": "ExportPackage.documentRefs[] -> BidDocument",
      "purpose": "固定本次递交使用的文件版本。"
    },
    {
      "id": "R16",
      "from": "AgentRun",
      "verb": "处理或产生",
      "to": "TenderSearchProfile|TenderProject|CompanyMaterial|RequirementComparison|BidDocument|ExportPackage",
      "cardinality": "N:N",
      "path": "AgentRun.inputSnapshot/outputRefs[] -> businessObject",
      "purpose": "满足自动化审计、回滚和问题定位。"
    }
  ],
  "provenanceContract": {
    "requiredOnSourceObjects": [
      "sourceName",
      "sourceUrl",
      "capturedAt",
      "ingestionChannel"
    ],
    "requiredOnFileVersions": [
      "versionNo",
      "contentHash",
      "storagePath",
      "uploadedAt",
      "parseStatus"
    ],
    "requiredOnEvidence": [
      "documentRef",
      "pageNo",
      "section",
      "quote",
      "fragmentHash",
      "verificationStatus"
    ],
    "requiredOnAiOutput": [
      "agentRunRef",
      "modelOrRuleVersion",
      "sourceRefs",
      "confidence",
      "humanReviewStatus"
    ],
    "missingEvidencePolicy": "没有项目、材料或文件证据的结论只能标记为待确认或待补材料，不得写入确定性承诺。"
  },
  "competencyQuestions": [
    {
      "id": "CQ01",
      "question": "这个项目是否值得参与？",
      "path": [
        "TenderProject",
        "BidWorkspace",
        "RequirementComparison",
        "CompanyMaterial"
      ],
      "answerMustInclude": [
        "参与建议",
        "否决性要求状态",
        "高风险项",
        "关键证据"
      ]
    },
    {
      "id": "CQ02",
      "question": "这个项目缺哪些材料？",
      "path": [
        "BidWorkspace",
        "RequirementComparison",
        "CompanyMaterial"
      ],
      "filter": [
        "comparisonConclusion in [不满足, 待补材料, 待澄清]"
      ]
    },
    {
      "id": "CQ03",
      "question": "投标截止时间和当前准备进度如何？",
      "path": [
        "TenderProject.scheduleItems[]",
        "BidWorkspace.tasks[]",
        "BidDocument"
      ]
    },
    {
      "id": "CQ04",
      "question": "标书是否可以导出递交？",
      "path": [
        "TenderProject.requirements[]",
        "RequirementComparison",
        "ReviewRecord",
        "BidDocument",
        "ExportPackage"
      ],
      "gate": [
        "所有否决性要求已有审核通过的比对结论",
        "所有必填章节已有响应",
        "完整性检查通过",
        "导出包引用固定文件版本"
      ]
    },
    {
      "id": "CQ05",
      "question": "这段标书内容的依据是什么？",
      "path": [
        "BidDocument.sections[]",
        "BidWorkspace.responses[]",
        "RequirementComparison",
        "CompanyMaterial.evidences[]",
        "TenderProject.evidences[]"
      ]
    }
  ],
  "businessRules": [
    {
      "id": "BR01",
      "name": "单一公司主体",
      "logic": "CompanyProfile 数量必须为 1，CompanyMaterial 必须归属于该主体。",
      "severity": "阻断"
    },
    {
      "id": "BR02",
      "name": "本地文件统一接入",
      "logic": "本地上传文件必须写入 TenderProject.documents[]，完成哈希、版本、解析和证据定位后才能进入比对或生成。",
      "severity": "阻断"
    },
    {
      "id": "BR03",
      "name": "补遗不覆盖历史",
      "logic": "补遗、答疑和延期追加为新 publication/document 版本，并将受影响要求和比对记录标记为待复核。",
      "severity": "高"
    },
    {
      "id": "BR04",
      "name": "要求必须有证据",
      "logic": "已确认的 TenderProject.requirements[] 必须有项目文件证据引用。",
      "severity": "阻断"
    },
    {
      "id": "BR05",
      "name": "材料有效期覆盖截止日",
      "logic": "用于满足资格要求的材料必须已核验，且 validTo 覆盖对应标段的投标截止时间。",
      "severity": "阻断"
    },
    {
      "id": "BR06",
      "name": "否决项导出闸门",
      "logic": "所有 criticality=否决性 的要求都必须有审核通过的比对结论和标书响应，否则禁止形成可递交 ExportPackage。",
      "severity": "阻断"
    },
    {
      "id": "BR07",
      "name": "正式内容有据可查",
      "logic": "BidWorkspace.responses[] 和 BidDocument.sections[] 必须关联要求、材料或证据引用；无依据内容只能标记待补充。",
      "severity": "阻断"
    },
    {
      "id": "BR08",
      "name": "自动化可回溯",
      "logic": "自动创建或修改正式业务数据时，必须记录 AgentRun 输入快照、模型或规则版本、状态、输出引用和异常摘要。",
      "severity": "高"
    },
    {
      "id": "BR09",
      "name": "AI 层语义去重",
      "logic": "同一业务语义只通过一个 semanticOwner 暴露；其他类通过关系或引用取得，不重复定义同义属性。",
      "severity": "高"
    }
  ],
  "automationFlow": [
    {
      "step": 1,
      "name": "搜索、筛选、下载",
      "inputs": [
        "CompanyProfile",
        "TenderSearchProfile",
        "公开平台或本地文件"
      ],
      "writes": [
        "TenderProject.source",
        "TenderProject.publications[]",
        "TenderProject.documents[]",
        "AgentRun"
      ],
      "humanGate": "低置信度候选、重复项目合并、验证码或登录、是否进入投标工作台"
    },
    {
      "step": 2,
      "name": "解析、比对、匹配",
      "inputs": [
        "TenderProject.documents[]",
        "CompanyProfile",
        "CompanyMaterial"
      ],
      "writes": [
        "TenderProject.requirements[]",
        "TenderProject.evaluationItems[]",
        "TenderProject.scheduleItems[]",
        "TenderProject.evidences[]",
        "BidWorkspace",
        "RequirementComparison",
        "AgentRun"
      ],
      "humanGate": "否决条款、资质有效性、关键业绩、人员可用性和是否参与"
    },
    {
      "step": 3,
      "name": "撰写、审核、输出",
      "inputs": [
        "BidWorkspace",
        "RequirementComparison",
        "CompanyMaterial",
        "BidTemplate"
      ],
      "writes": [
        "BidDocument",
        "ReviewRecord",
        "ExportPackage",
        "AgentRun"
      ],
      "humanGate": "商务承诺、报价、最终正文、签章和递交"
    }
  ],
  "aiUsageContract": {
    "retrievalBoundary": "大模型只能读取受控检索返回的实体、关系、属性和证据，不能直接猜测企业事实或项目条款。",
    "modelResponsibilities": [
      "从文件抽取候选项目、要求、评分项和时间节点",
      "把自然语言问题转换为受控检索条件",
      "基于检索结果解释匹配结论、起草响应和组织章节",
      "标出材料缺失、证据不足和需要人工确认的内容"
    ],
    "programResponsibilities": [
      "文件哈希、版本、权限、有效期和导出闸门判断",
      "结构化检索、规则比对、完整性检查和引用校验",
      "拒绝把没有检索依据的模型输出写入正式标书"
    ],
    "answerPolicy": "每个结论必须附带实体引用、文件版本和证据定位；资料库没有依据时明确回答“资料库未找到依据”或“需要人工确认”。"
  }
}
