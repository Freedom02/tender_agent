# 复制为 .env 后修改。.env 必须加入 .gitignore，绝不要提交到仓库。
#
# 注意：账号密码不要复用公司统一账号，这是开发库，单独建一个。

POSTGRES_USER=tender_app
POSTGRES_PASSWORD=改成一个强密码_不要用tender123这种

# 主开发库
POSTGRES_DB=tender_agent_dev

# 端口与绑定地址
PG_PORT=5432
# 127.0.0.1 = 只允许本机连（安全默认）
# 0.0.0.0   = 允许局域网/隧道访问（要给伙伴连时才改）
PG_BIND=127.0.0.1

# 可选：给每个伙伴一个独立库，避免互相踩数据（逗号分隔，不要有空格）
# EXTRA_DATABASES=tender_dev_alice,tender_dev_bob
EXTRA_DATABASES=
