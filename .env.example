# AI / LLM 连接
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-me
AI_MODEL=gpt-4o-mini

# 智能体提供方：dify 或 pi
AGENT_PROVIDER=dify

# 云端智能体（Dify Workflow）
DIFY_ENABLED=true
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_PARSE_WORKFLOW_KEY=
DIFY_SECTION_WORKFLOW_KEY=
DIFY_REVIEW_WORKFLOW_KEY=
DIFY_API_TIMEOUT=180

# 本地 Pi 智能体（无需 Docker；需先安装 pi 命令）
PI_ENABLED=true
PI_COMMAND=pi
PI_PROVIDER=
PI_MODEL=
PI_API_KEY=
PI_API_TIMEOUT=360
PI_WORKING_DIR=
PI_PARSE_WORKERS=3
PI_PARSE_TIMEOUT=1200

# M3 图数据库连接（企业材料单一事实源）
M3_HOST=
M3_COMPANY=
M3_USER=
M3_PASSWORD=
